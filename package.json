{
  "name": "habit-tally",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "VITE_BACKEND=demo vite",
    "dev:emulator": "VITE_BACKEND=emulator vite",
    "emulators": "firebase emulators:start --only firestore,auth --project demo-habit-tally",
    "build": "vite build",
    "build:demo": "VITE_BACKEND=demo vite build --outDir dist-demo",
    "preview": "vite preview",
    "test": "node --test test/*.test.mjs",
    "test:emulator": "firebase emulators:exec --only firestore,auth --project demo-habit-tally \"node --test --test-concurrency=1 test/emulator/*.test.mjs\"",
    "test:e2e": "npm run build:demo && playwright test",
    "test:e2e:emulator": "playwright test -c playwright.emulator.config.js"
  },
  "dependencies": {
    "firebase": "^13.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "1.63.0",
    "firebase-tools": "^15.36.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
